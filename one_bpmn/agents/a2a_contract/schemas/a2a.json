{
  "protocolVersion": "0.3.0",
  "states": [
    "submitted",
    "working",
    "input-required",
    "completed",
    "canceled",
    "failed",
    "rejected",
    "auth-required",
    "timed-out"
  ],
  "terminalStates": ["completed", "canceled", "failed", "rejected", "timed-out"],
  "errorCodes": {
    "PARSE_ERROR": -32700,
    "INVALID_REQUEST": -32600,
    "METHOD_NOT_FOUND": -32601,
    "INVALID_PARAMS": -32602,
    "INTERNAL_ERROR": -32603,
    "TASK_NOT_FOUND": -32001,
    "TASK_NOT_CANCELABLE": -32002,
    "PUSH_NOTIFICATION_NOT_SUPPORTED": -32003,
    "UNSUPPORTED_OPERATION": -32004,
    "CONTENT_TYPE_NOT_SUPPORTED": -32005,
    "INVALID_AGENT_RESPONSE": -32006
  },
  "traceMetadataKeys": {
    "taskExecutionId": "onefm_task_execution_id",
    "delegationDepth": "onefm_delegation_depth",
    "handoffCount": "onefm_handoff_count"
  },
  "schemas": {
    "rpc_request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "number"] },
        "method": {
          "type": "string",
          "enum": ["message/send", "message/stream", "tasks/get", "tasks/cancel"]
        },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": ["role", "parts"],
      "properties": {
        "role": { "type": "string", "enum": ["user", "agent"] },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "messageId": { "type": "string" },
        "taskId": { "type": "string" },
        "contextId": { "type": "string" },
        "kind": { "const": "message" },
        "metadata": { "type": "object" }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string" },
        "contextId": { "type": "string" },
        "kind": { "const": "task" },
        "status": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "submitted",
                "working",
                "input-required",
                "completed",
                "canceled",
                "failed",
                "rejected",
                "auth-required",
                "timed-out"
              ]
            },
            "message": { "type": "object" },
            "timestamp": { "type": "string" }
          }
        },
        "artifacts": { "type": "array" },
        "history": { "type": "array" },
        "metadata": { "type": "object" }
      }
    },
    "agent_card": {
      "type": "object",
      "required": [
        "protocolVersion",
        "name",
        "description",
        "url",
        "version",
        "capabilities",
        "defaultInputModes",
        "defaultOutputModes",
        "skills"
      ],
      "properties": {
        "protocolVersion": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "version": { "type": "string" },
        "capabilities": {
          "type": "object",
          "properties": {
            "streaming": { "type": "boolean" },
            "pushNotifications": { "type": "boolean" },
            "stateTransitionHistory": { "type": "boolean" }
          }
        },
        "securitySchemes": { "type": "object" },
        "defaultInputModes": { "type": "array", "items": { "type": "string" } },
        "defaultOutputModes": { "type": "array", "items": { "type": "string" } },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "description", "tags"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "tags": { "type": "array", "items": { "type": "string" } },
              "examples": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "subAgents": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
