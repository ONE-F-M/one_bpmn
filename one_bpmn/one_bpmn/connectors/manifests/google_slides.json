{
  "connectorId": "google_slides",
  "label": "Google Slides",
  "icon": {
    "path": "M3 4h18v2H3zm1 3h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zm2 2v7h12V9z",
    "color": "#fbbc04",
    "label": "Google Slides"
  },
  "description": "Create and edit Google Slides decks \u2014 template fill, add/duplicate slides, read text.",
  "api": {
    "name": "slides",
    "version": "v1",
    "discovery": "https://slides.googleapis.com/$discovery/rest?version=v1"
  },
  "operations": [
    {
      "value": "createPresentation",
      "label": "Create presentation",
      "method": "files.create (Drive) \u2014 see google_slides.create_presentation",
      "fields": [
        {
          "name": "folder",
          "label": "Folder",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "required": true,
          "expression": true,
          "help": "Destination Drive folder \u2014 paste a folder link or id. Must be a Shared Drive folder the service account can write to: a service account has no My Drive quota of its own."
        },
        {
          "name": "title",
          "label": "Title",
          "type": "String",
          "required": true,
          "expression": true
        }
      ],
      "output": {
        "presentationId": "New presentation id",
        "title": "Title",
        "url": "Open-in-Drive URL"
      }
    },
    {
      "value": "replaceAllText",
      "label": "Replace all text (deck template fill)",
      "method": "presentations.batchUpdate \u2192 replaceAllText",
      "fields": [
        {
          "name": "presentation",
          "label": "Presentation",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "required": true,
          "expression": true
        },
        {
          "name": "find",
          "label": "Find text",
          "type": "String",
          "required": true,
          "expression": true
        },
        {
          "name": "replace",
          "label": "Replace with",
          "type": "Text",
          "expression": true
        },
        {
          "name": "matchCase",
          "label": "Match case",
          "type": "Boolean",
          "default": false
        }
      ],
      "output": {
        "presentationId": "Presentation id",
        "occurrencesChanged": "Number of replacements"
      }
    },
    {
      "value": "createSlide",
      "label": "Add slide",
      "method": "presentations.batchUpdate \u2192 createSlide",
      "fields": [
        {
          "name": "presentation",
          "label": "Presentation",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "required": true,
          "expression": true
        },
        {
          "name": "layout",
          "label": "Layout",
          "type": "Dropdown",
          "default": "",
          "choices": [
            {
              "label": "Blank",
              "value": "BLANK"
            },
            {
              "label": "Title",
              "value": "TITLE"
            },
            {
              "label": "Title and body",
              "value": "TITLE_AND_BODY"
            },
            {
              "label": "Section header",
              "value": "SECTION_HEADER"
            },
            {
              "label": "One column text",
              "value": "ONE_COLUMN_TEXT"
            }
          ]
        }
      ],
      "output": {
        "presentationId": "Presentation id",
        "slideObjectId": "New slide object id"
      }
    },
    {
      "value": "duplicateSlide",
      "label": "Duplicate slide",
      "method": "presentations.batchUpdate \u2192 duplicateObject",
      "fields": [
        {
          "name": "presentation",
          "label": "Presentation",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "required": true,
          "expression": true
        },
        {
          "name": "slideObjectId",
          "label": "Slide object id",
          "type": "String",
          "required": true,
          "expression": true
        }
      ],
      "output": {
        "presentationId": "Presentation id",
        "duplicatedObjectId": "Duplicated slide object id"
      }
    },
    {
      "value": "getText",
      "label": "Get text",
      "method": "presentations.get + walk",
      "fields": [
        {
          "name": "presentation",
          "label": "Presentation",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "required": true,
          "expression": true
        }
      ],
      "output": {
        "text": "Plain text across all slides"
      }
    }
  ],
  "execution": {
    "type": "Python Handler"
  }
}
