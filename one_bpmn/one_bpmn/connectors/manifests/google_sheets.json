{
  "connectorId": "google_sheets",
  "label": "Google Sheets",
  "icon": "sheets",
  "description": "Create spreadsheets and read/write/append/clear cell ranges.",
  "api": { "name": "sheets", "version": "v4", "discovery": "https://sheets.googleapis.com/$discovery/rest?version=v4" },
  "operations": [
    {
      "value": "createSpreadsheet",
      "label": "Create spreadsheet",
      "method": "drive.files.create (spreadsheet mimeType)",
      "fields": [
        { "name": "title", "label": "Title", "type": "String", "required": true, "expression": true },
        { "name": "folder", "label": "Folder", "type": "DriveFolder", "required": true, "expression": true,
          "help": "Destination Drive folder (Shared Drive). Paste a folder link or id." }
      ],
      "output": { "spreadsheetId": "New spreadsheet id", "title": "Title", "url": "Open-in-Sheets URL" }
    },
    {
      "value": "getValues",
      "label": "Get values",
      "method": "spreadsheets.values.get",
      "fields": [
        { "name": "spreadsheet", "label": "Spreadsheet", "type": "DriveFile", "required": true, "expression": true },
        { "name": "range", "label": "Range (A1)", "type": "String", "required": true, "default": "A1:Z1000", "expression": true,
          "help": "A1 notation, e.g. Sheet1!A1:D50" }
      ],
      "output": { "range": "Resolved range", "values": "2D array of cell values" }
    },
    {
      "value": "updateValues",
      "label": "Update values",
      "method": "spreadsheets.values.update",
      "fields": [
        { "name": "spreadsheet", "label": "Spreadsheet", "type": "DriveFile", "required": true, "expression": true },
        { "name": "range", "label": "Range (A1)", "type": "String", "required": true, "expression": true },
        { "name": "values", "label": "Values (JSON 2D array)", "type": "Text", "required": true, "expression": true,
          "help": "e.g. [[\"Name\",\"Score\"],[\"Ann\",42]]" },
        { "name": "valueInputOption", "label": "Input mode", "type": "Dropdown", "default": "USER_ENTERED",
          "choices": [
            { "label": "User entered (parse formulas/dates)", "value": "USER_ENTERED" },
            { "label": "Raw", "value": "RAW" }
          ]}
      ],
      "output": { "updatedRange": "Range written", "updatedCells": "Number of cells updated" }
    },
    {
      "value": "appendValues",
      "label": "Append rows",
      "method": "spreadsheets.values.append",
      "fields": [
        { "name": "spreadsheet", "label": "Spreadsheet", "type": "DriveFile", "required": true, "expression": true },
        { "name": "range", "label": "Range (A1)", "type": "String", "default": "A1", "expression": true },
        { "name": "values", "label": "Rows (JSON 2D array)", "type": "Text", "required": true, "expression": true,
          "help": "e.g. [[\"Ann\",42],[\"Bob\",37]]" },
        { "name": "valueInputOption", "label": "Input mode", "type": "Dropdown", "default": "USER_ENTERED",
          "choices": [
            { "label": "User entered (parse formulas/dates)", "value": "USER_ENTERED" },
            { "label": "Raw", "value": "RAW" }
          ]}
      ],
      "output": { "updatedRange": "Range written", "updatedCells": "Number of cells appended" }
    },
    {
      "value": "clearValues",
      "label": "Clear range",
      "method": "spreadsheets.values.clear",
      "fields": [
        { "name": "spreadsheet", "label": "Spreadsheet", "type": "DriveFile", "required": true, "expression": true },
        { "name": "range", "label": "Range (A1)", "type": "String", "required": true, "expression": true }
      ],
      "output": { "clearedRange": "Range cleared" }
    },
    {
      "value": "addSheet",
      "label": "Add sheet (tab)",
      "method": "spreadsheets.batchUpdate → addSheet",
      "fields": [
        { "name": "spreadsheet", "label": "Spreadsheet", "type": "DriveFile", "required": true, "expression": true },
        { "name": "title", "label": "Sheet title", "type": "String", "required": true, "expression": true }
      ],
      "output": { "spreadsheetId": "Spreadsheet id", "sheetId": "New sheet id", "title": "Sheet title" }
    }
  ]
}
