{
  "connectorId": "google_drive",
  "label": "Google Drive",
  "icon": "drive",
  "description": "Read, create, update, share and list files in Google Drive.",
  "api": { "name": "drive", "version": "v3", "discovery": "https://www.googleapis.com/discovery/v1/apis/drive/v3/rest" },
  "operations": [
    {
      "value": "downloadText",
      "label": "Download text",
      "method": "files.export / files.get(media)",
      "fields": [
        { "name": "file", "label": "File", "type": "DriveFile", "required": true, "expression": true,
          "help": "The file to read. Paste a Drive link or a file id." }
      ],
      "output": { "text": "Plain-text content of the file" }
    },
    {
      "value": "createFile",
      "label": "Create file",
      "method": "files.create",
      "fields": [
        { "name": "folder", "label": "Folder", "type": "DriveFolder", "required": true, "expression": true,
          "help": "Destination Drive folder — paste a folder link or id. The service account must have write access." },
        { "name": "filename", "label": "File name", "type": "String", "required": true, "expression": true },
        { "name": "content", "label": "Content", "type": "Text", "expression": true },
        { "name": "targetMimeType", "label": "Create as", "type": "Dropdown", "default": "application/vnd.google-apps.document",
          "choices": [
            { "label": "Google Doc", "value": "application/vnd.google-apps.document" },
            { "label": "Google Slides", "value": "application/vnd.google-apps.presentation" },
            { "label": "Google Sheet", "value": "application/vnd.google-apps.spreadsheet" },
            { "label": "Keep source format", "value": "" }
          ]},
        { "name": "sourceMimeType", "label": "Source format", "type": "String", "default": "text/markdown" }
      ],
      "output": { "id": "File id", "name": "File name", "webViewLink": "Open-in-Drive URL" }
    },
    {
      "value": "updateFileContent",
      "label": "Update file content",
      "method": "files.update",
      "fields": [
        { "name": "file", "label": "File", "type": "DriveFile", "required": true, "expression": true },
        { "name": "content", "label": "Content", "type": "Text", "expression": true },
        { "name": "sourceMimeType", "label": "Source format", "type": "String", "default": "text/markdown" }
      ],
      "output": { "id": "File id", "name": "File name", "webViewLink": "Open-in-Drive URL" }
    },
    {
      "value": "setPermissions",
      "label": "Share file",
      "method": "permissions.create",
      "fields": [
        { "name": "file", "label": "File", "type": "DriveFile", "required": true, "expression": true },
        { "name": "type", "label": "Grantee type", "type": "Dropdown", "required": true,
          "choices": [
            { "label": "User", "value": "user" },
            { "label": "Group", "value": "group" },
            { "label": "Domain", "value": "domain" },
            { "label": "Anyone", "value": "anyone" }
          ]},
        { "name": "role", "label": "Role", "type": "Dropdown", "required": true, "default": "reader",
          "choices": [
            { "label": "Reader", "value": "reader" },
            { "label": "Commenter", "value": "commenter" },
            { "label": "Writer", "value": "writer" },
            { "label": "File organizer", "value": "fileOrganizer" },
            { "label": "Organizer", "value": "organizer" },
            { "label": "Owner", "value": "owner" }
          ]},
        { "name": "emailAddress", "label": "Email", "type": "String", "expression": true,
          "condition": { "field": "type", "oneOf": ["user", "group"] } },
        { "name": "domain", "label": "Domain", "type": "String", "expression": true,
          "condition": { "field": "type", "equals": "domain" } },
        { "name": "grants", "label": "Grants (advanced JSON)", "type": "Text", "expression": true,
          "help": "Optional: a JSON array of Permission resources. Overrides the single grant above." }
      ],
      "output": { "granted": "Number of permissions applied" }
    },
    {
      "value": "listFiles",
      "label": "List files",
      "method": "files.list",
      "fields": [
        { "name": "folder", "label": "Folder", "type": "DriveFolder", "required": true, "expression": true },
        { "name": "pageSize", "label": "Max results", "type": "String", "default": "20" }
      ],
      "output": { "files": "Array of {id,name,mimeType,modifiedTime}", "count": "Number of files" }
    },
    {
      "value": "deleteFile",
      "label": "Delete file",
      "method": "files.delete / files.update(trashed)",
      "fields": [
        { "name": "file", "label": "File", "type": "DriveFile", "required": true, "expression": true },
        { "name": "permanent", "label": "Delete permanently", "type": "Boolean", "default": false,
          "help": "Off = move to Drive trash (recoverable). On = bypass trash." }
      ],
      "output": { "deleted": "File id", "permanent": "Whether it bypassed trash" }
    }
  ]
}
