{
  "connectorId": "google_drive",
  "label": "Google Drive",
  "icon": {
    "path": "M7.71 3.5 1.15 15l3.42 6 6.57-11.5zM9.73 15l-3.42 6h13.54l3.42-6zM22.85 15 16.28 3.5H9.44l6.57 11.5z",
    "color": "#4285f4",
    "label": "Google Drive"
  },
  "description": "Read, create, update, share and list files in Google Drive.",
  "api": {
    "name": "drive",
    "version": "v3",
    "discovery": "https://www.googleapis.com/discovery/v1/apis/drive/v3/rest"
  },
  "operations": [
    {
      "value": "downloadText",
      "label": "Download text",
      "method": "files.export / files.get(media)",
      "fields": [
        {
          "name": "file",
          "label": "File",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "required": true,
          "expression": true,
          "help": "The file to read. Paste a Drive link or a file id."
        }
      ],
      "output": {
        "text": "Plain-text content of the file"
      }
    },
    {
      "value": "copyFile",
      "label": "Copy file (instantiate a template)",
      "method": "files.copy",
      "help": "Duplicates a document, keeping its design exactly — logos, tables, named styles, bilingual layout and RTL runs all survive. Use this to instantiate a branded template, then fill it with Google Docs → Fill template. Do NOT follow it with Update file content: that replaces the whole body and destroys the template.",
      "fields": [
        {
          "name": "file",
          "label": "Template",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "required": true,
          "expression": true,
          "help": "The template to copy — paste its link or id. The service account needs at least Viewer on it."
        },
        {
          "name": "filename",
          "label": "New file name",
          "type": "String",
          "expression": true,
          "help": "Leave blank and Drive names it “Copy of …” — pass the real document title instead."
        },
        {
          "name": "folder",
          "label": "Destination folder",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "expression": true,
          "help": "Where the copy goes. Omit it and the copy lands beside the template, which is almost never wanted."
        }
      ],
      "output": {
        "id": "File id",
        "name": "File name",
        "webViewLink": "Open-in-Drive URL"
      }
    },
    {
      "value": "createFile",
      "label": "Create file",
      "method": "files.create",
      "fields": [
        {
          "name": "folder",
          "label": "Folder",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "required": true,
          "expression": true,
          "help": "Destination Drive folder — paste a folder link or id. The service account must have write access."
        },
        {
          "name": "filename",
          "label": "File name",
          "type": "String",
          "required": true,
          "expression": true
        },
        {
          "name": "content",
          "label": "Content",
          "type": "Text",
          "expression": true
        },
        {
          "name": "targetMimeType",
          "label": "Create as",
          "type": "Dropdown",
          "default": "application/vnd.google-apps.document",
          "choices": [
            {
              "label": "Google Doc",
              "value": "application/vnd.google-apps.document"
            },
            {
              "label": "Google Slides",
              "value": "application/vnd.google-apps.presentation"
            },
            {
              "label": "Google Sheet",
              "value": "application/vnd.google-apps.spreadsheet"
            },
            {
              "label": "Keep source format",
              "value": ""
            }
          ]
        },
        {
          "name": "sourceMimeType",
          "label": "Source format",
          "type": "String",
          "default": "text/markdown"
        }
      ],
      "output": {
        "id": "File id",
        "name": "File name",
        "webViewLink": "Open-in-Drive URL"
      }
    },
    {
      "value": "updateFileContent",
      "label": "Update file content",
      "method": "files.update",
      "fields": [
        {
          "name": "file",
          "label": "File",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "required": true,
          "expression": true
        },
        {
          "name": "content",
          "label": "Content",
          "type": "Text",
          "expression": true
        },
        {
          "name": "sourceMimeType",
          "label": "Source format",
          "type": "String",
          "default": "text/markdown"
        }
      ],
      "output": {
        "id": "File id",
        "name": "File name",
        "webViewLink": "Open-in-Drive URL"
      }
    },
    {
      "value": "setPermissions",
      "label": "Share file",
      "method": "permissions.create",
      "fields": [
        {
          "name": "file",
          "label": "File",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "required": true,
          "expression": true
        },
        {
          "name": "type",
          "label": "Grantee type",
          "type": "Dropdown",
          "required": true,
          "choices": [
            {
              "label": "User",
              "value": "user"
            },
            {
              "label": "Group",
              "value": "group"
            },
            {
              "label": "Domain",
              "value": "domain"
            },
            {
              "label": "Anyone",
              "value": "anyone"
            }
          ]
        },
        {
          "name": "role",
          "label": "Role",
          "type": "Dropdown",
          "required": true,
          "default": "reader",
          "choices": [
            {
              "label": "Reader",
              "value": "reader"
            },
            {
              "label": "Commenter",
              "value": "commenter"
            },
            {
              "label": "Writer",
              "value": "writer"
            },
            {
              "label": "File organizer",
              "value": "fileOrganizer"
            },
            {
              "label": "Organizer",
              "value": "organizer"
            },
            {
              "label": "Owner",
              "value": "owner"
            }
          ]
        },
        {
          "name": "emailAddress",
          "label": "Email",
          "type": "String",
          "expression": true,
          "condition": {
            "field": "type",
            "oneOf": [
              "user",
              "group"
            ]
          }
        },
        {
          "name": "domain",
          "label": "Domain",
          "type": "String",
          "expression": true,
          "condition": {
            "field": "type",
            "equals": "domain"
          }
        },
        {
          "name": "grants",
          "label": "Grants (advanced JSON)",
          "type": "Text",
          "expression": true,
          "help": "Optional: a JSON array of Permission resources. Overrides the single grant above."
        }
      ],
      "output": {
        "granted": "Number of permissions applied"
      }
    },
    {
      "value": "revokePermissions",
      "label": "Revoke sharing",
      "method": "permissions.list + permissions.delete",
      "description": "Withdraw access without touching the file. The counterpart to Share file — use it to take a document out of circulation while keeping it and its history intact.",
      "fields": [
        {
          "name": "file",
          "label": "File",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "required": true,
          "expression": true
        },
        {
          "name": "scope",
          "label": "Revoke",
          "type": "Dropdown",
          "required": true,
          "default": "all",
          "choices": [
            {
              "label": "All sharing (keep owner)",
              "value": "all"
            },
            {
              "label": "Domain grants only",
              "value": "domain"
            },
            {
              "label": "User grants only",
              "value": "user"
            }
          ]
        },
        {
          "name": "match",
          "label": "Only this domain / email",
          "type": "String",
          "expression": true,
          "condition": {
            "field": "scope",
            "oneOf": [
              "domain",
              "user"
            ]
          },
          "help": "Optional. Leave blank to revoke every grant of the chosen kind. The owner is never removed."
        }
      ],
      "output": {
        "revoked": "Number of grants removed",
        "skipped": "Number that could not be removed (structural or inherited from a parent folder)",
        "grants": "The grants that were removed",
        "skipped_grants": "The grants that were left, each with a reason",
        "file": "File id"
      }
    },
    {
      "value": "listFiles",
      "label": "List files",
      "method": "files.list",
      "fields": [
        {
          "name": "folder",
          "label": "Folder",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "required": true,
          "expression": true
        },
        {
          "name": "pageSize",
          "label": "Max results",
          "type": "String",
          "default": "20"
        }
      ],
      "output": {
        "files": "Array of {id,name,mimeType,modifiedTime}",
        "count": "Number of files"
      }
    },
    {
      "value": "deleteFile",
      "label": "Delete file",
      "method": "files.delete / files.update(trashed)",
      "fields": [
        {
          "name": "file",
          "label": "File",
          "type": "String",
          "transform": "one_bpmn.one_bpmn.integrations.google_common.normalize_drive_id",
          "required": true,
          "expression": true
        },
        {
          "name": "permanent",
          "label": "Delete permanently",
          "type": "Boolean",
          "default": false,
          "help": "Off = move to Drive trash (recoverable). On = bypass trash."
        }
      ],
      "output": {
        "deleted": "File id",
        "permanent": "Whether it bypassed trash"
      }
    }
  ],
  "execution": {
    "type": "Python Handler"
  }
}
