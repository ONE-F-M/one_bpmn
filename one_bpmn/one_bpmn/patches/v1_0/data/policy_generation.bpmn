<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_POLICY" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="policy_generation_process" name="Policy Generation from Guidelines" isExecutable="true">
    <bpmn:documentation>Two-phase approval: (1) the request is approved first — that approval fixes document_type/folder — and the file is created immediately, before any content exists; (2) the Author then writes/finalizes the document (AI-assisted draft available, but manual editing works exactly the same way — "either way"), and goes back through a second approval on the finished content before it's published.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_author" name="Employee">
        <bpmn:flowNodeRef>write_document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_content_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>set_status_content_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0lo7hq2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_approver" name="Projects Manager">
        <bpmn:flowNodeRef>request_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>set_status_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_request_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>content_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_content</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_controller" name="System Manager">
        <bpmn:flowNodeRef>notify_request_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_content_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>set_status_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save_content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>set_perms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>index_doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>set_status_published</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_published</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>set_status_drafting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>locate_existing_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_action_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delete_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>set_status_deleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_deleted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_ai_system" name="Agent">
        <bpmn:flowNodeRef>fetch_guideline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather_context</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sop_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fetch_sop_template</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Request Submitted" spiffworkflow:triggerDoctype="Document Request" spiffworkflow:triggerType="After Insert">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CondDef_Start" spiffworkflow:triggerDoctype="Document Request" spiffworkflow:triggerType="After Insert">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">document_type == "Policy"</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:userTask id="request_approval" name="Approve Request and defining the file location" spiffworkflow:assigneeMode="DocField" spiffworkflow:targetDoctype="Document Request" spiffworkflow:assigneeDocfield="approver_user" spiffworkflow:taskActions="[{&#34;action&#34;:&#34;Approve&#34;,&#34;confirmTransition&#34;:&#34;true&#34;},{&#34;action&#34;:&#34;Reject&#34;,&#34;confirmTransition&#34;:&#34;true&#34;}]">
      <bpmn:documentation>Approver confirms document_type and the destination folder for this request, before any content exists.</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_request" name="Request Approved?" default="f4">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_rejected" name="Request Rejected">
      <bpmn:incoming>Flow_0mot6rw</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="notify_request_approved" name="Notify: Request Approved" spiffworkflow:serviceType="send_email" spiffworkflow:emailSubject="Your document request has been approved" spiffworkflow:emailToDocFields="requester_user" spiffworkflow:emailBody="SGksCgpZb3VyIHJlcXVlc3QgZm9yICd7eyBkb2MudGl0bGUgfX0nICh7eyBkb2MuZG9jdW1lbnRfdHlwZSB9fSkgaGFzIGJlZW4gYXBwcm92ZWQgYnkge3sgZG9jLmFwcHJvdmVyIH19LiBUaGUgZG9jdW1lbnQgaXMgbm93IGJlaW5nIGRyYWZ0ZWQuCgrigJQgUHJvY2Vzc2E=">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f3b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="set_status_drafting" name="Set Status: Drafting" spiffworkflow:serviceType="update_field" spiffworkflow:updateFieldRows="[{&#34;field&#34;: &#34;status&#34;, &#34;value&#34;: &#34;Drafting&#34;}]">
      <bpmn:incoming>f3b</bpmn:incoming>
      <bpmn:outgoing>f3c</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="notify_request_rejected" name="Notify: Request Rejected" spiffworkflow:serviceType="send_email" spiffworkflow:emailSubject="Your document request has been rejected" spiffworkflow:emailToDocFields="requester_user" spiffworkflow:emailBody="SGksCgpZb3VyIHJlcXVlc3QgZm9yICd7eyBkb2MudGl0bGUgfX0nICh7eyBkb2MuZG9jdW1lbnRfdHlwZSB9fSkgaGFzIGJlZW4gcmVqZWN0ZWQgYnkge3sgZG9jLmFwcHJvdmVyIH19LgoK4oCUIFByb2Nlc3Nh">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>Flow_04sgar6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="set_status_rejected" name="Set Status: Request Rejected" spiffworkflow:serviceType="update_field" spiffworkflow:updateFieldDoctype="Document Request" spiffworkflow:updateFieldRows="[{&#34;field&#34;: &#34;status&#34;, &#34;value&#34;: &#34;Request Rejected&#34;}]">
      <bpmn:incoming>Flow_04sgar6</bpmn:incoming>
      <bpmn:outgoing>Flow_0mot6rw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="notify_content_approved" name="Notify: Document Approved" spiffworkflow:serviceType="send_email" spiffworkflow:emailSubject="Your document has been approved" spiffworkflow:emailToDocFields="requester_user" spiffworkflow:emailBody="SGksCgpUaGUgZmluaXNoZWQgZG9jdW1lbnQgZm9yICd7eyBkb2MudGl0bGUgfX0nIGhhcyBiZWVuIGFwcHJvdmVkIGJ5IHt7IGRvYy5hcHByb3ZlciB9fSBhbmQgaXMgYmVpbmcgcHVibGlzaGVkLgoK4oCUIFByb2Nlc3Nh">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f11e</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="set_status_approved" name="Set Status: Approved" spiffworkflow:serviceType="update_field" spiffworkflow:updateFieldRows="[{&#34;field&#34;: &#34;status&#34;, &#34;value&#34;: &#34;Approved&#34;}]">
      <bpmn:incoming>f11e</bpmn:incoming>
      <bpmn:outgoing>f11c</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="notify_content_rejected" name="Notify: Document Rejected" spiffworkflow:serviceType="send_email" spiffworkflow:emailSubject="Your document was not approved" spiffworkflow:emailToDocFields="requester_user" spiffworkflow:emailBody="SGksCgpUaGUgZmluaXNoZWQgZG9jdW1lbnQgZm9yICd7eyBkb2MudGl0bGUgfX0nIHdhcyBub3QgYXBwcm92ZWQgYnkge3sgZG9jLmFwcHJvdmVyIH19IGFuZCBuZWVkcyByZXZpc2lvbi4gUGxlYXNlIGNoZWNrIHRoZSByZXZpZXdlcidzIGNvbW1lbnRzIGFuZCByZXN1Ym1pdC4KCuKAlCBQcm9jZXNzYQ==">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f12d</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="set_status_content_rejected" name="Set Status: Content Rejected" spiffworkflow:serviceType="update_field" spiffworkflow:updateFieldRows="[{&#34;field&#34;: &#34;status&#34;, &#34;value&#34;: &#34;Content Rejected&#34;}]">
      <bpmn:incoming>f12d</bpmn:incoming>
      <bpmn:outgoing>f12b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_action" name="Action?" default="f3d">
      <bpmn:incoming>f3c</bpmn:incoming>
      <bpmn:outgoing>f3d</bpmn:outgoing>
      <bpmn:outgoing>f3e</bpmn:outgoing>
      <bpmn:outgoing>f3f</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="locate_existing_file" name="Locate Existing File in Drive" spiffworkflow:serverScript="Drive — Locate Existing File" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="Drive — Locate Existing File">
      <bpmn:documentation>Update path: pulls the Drive file id/link off the linked AI Reference Index record (reference_document) instead of creating a new file, so the rest of the pipeline (draft, approve, save, index) acts on the existing document.</bpmn:documentation>
      <bpmn:incoming>f3e</bpmn:incoming>
      <bpmn:outgoing>f5b</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="delete_file" name="Delete File from Drive" spiffworkflow:serverScript="Drive — Delete File" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="Drive — Delete File">
      <bpmn:documentation>Delete path: trashes the Drive file linked from reference_document. The AI Reference Index catalog record itself is left untouched, for audit/reference.</bpmn:documentation>
      <bpmn:incoming>f3f</bpmn:incoming>
      <bpmn:outgoing>f_del1</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="set_status_deleted" name="Set Status: Deleted" spiffworkflow:serviceType="update_field" spiffworkflow:updateFieldDoctype="Document Request" spiffworkflow:updateFieldRows="[{&#34;field&#34;: &#34;status&#34;, &#34;value&#34;: &#34;Deleted&#34;}]">
      <bpmn:incoming>f_del1</bpmn:incoming>
      <bpmn:outgoing>f_del2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_deleted" name="Document Deleted">
      <bpmn:incoming>f_del2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_action_merge">
      <bpmn:incoming>f5a</bpmn:incoming>
      <bpmn:incoming>f5b</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="create_file" name="Create File in Drive Folder" spiffworkflow:serverScript="Drive — Create File" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="Drive — Create File">
      <bpmn:documentation>Creates an empty placeholder file in the Google Shared Drive folder document_type resolves to (via AI Chat Settings &gt; Google Drive Settings) — before any content is written. Reusable Server Script, referenceable from any diagram's Script Task, not a one-off dispatcher. Requires: Drive API enabled on the GCP project, the service account added to the Shared Drive, and Drive Folder IDs configured on AI Chat Settings — none of which is done yet as of this writing, so this will fail (non-fatally, logged) until then.</bpmn:documentation>
      <bpmn:incoming>f3d</bpmn:incoming>
      <bpmn:outgoing>f5a</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="gather_context" name="Gather Reference Context (Drive)" spiffworkflow:serverScript="Drive — Gather Reference" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="Drive — Gather Reference">
      <bpmn:documentation>Lists + extracts text from Guideline/Policy files in the configured Drive folders (task variable drive_folder_ids, comma-separated), keyword-matches against requirement_text, writes the top matches into reference_context. drive_folder_ids is empty until real Shared Drive folder IDs for Guidelines/Policies are supplied — until then this safely no-ops (reference_context stays "").</bpmn:documentation>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="fetch_guideline" name="Fetch Guideline Content (Drive)" spiffworkflow:serverScript="Drive — Fetch Guideline Content" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="Drive — Fetch Guideline Content">
      <bpmn:documentation>Extracts the real text/slide content of the guideline document picked on the request (source_guideline, an existing AI Reference Index entry) — no AI drafting here, this is the actual existing guideline converted to a format the SOP-drafting task can read.</bpmn:documentation>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="fetch_sop_template" name="Fetch SOP Template (Drive)" spiffworkflow:serverScript="Drive — Fetch SOP Template" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="Drive — Fetch SOP Template">
      <bpmn:documentation>Fetches the real text of the canonical SOP template (AI Chat Settings &gt; Google Drive Settings &gt; SOP Template File ID) — the actual existing document defines the format, not a hard-coded description in this diagram.</bpmn:documentation>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f7b</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="sop_task" name="AI Agent Task: Draft Policy from Guideline" spiffworkflow:serviceType="ai_agent" spiffworkflow:aiBackend="direct_api" spiffworkflow:aiProvider="Anthropic Sonnet" spiffworkflow:aiModel="claude-sonnet-4-5-20250929" spiffworkflow:aiOutputVariable="sop_markdown" spiffworkflow:aiSystemPrompt="You convert an internal guideline document into a Policy. You are given the real, existing ONE-FM Policy template below — match its exact structure, section order, headings, table columns, and bilingual (English/Arabic) formatting precisely. Do not invent structure beyond what the template shows." spiffworkflow:aiUserPrompt="Policy Template (existing document — match this exact structure):&#10;&#10;{{sop_template_content}}&#10;&#10;Guideline document (existing, extracted from Drive):&#10;&#10;{{guideline_content}}&#10;&#10;Additional related context (if any):&#10;&#10;{{reference_context}}&#10;&#10;Revision feedback (if any): {{review_feedback}}" spiffworkflow:aiResponseFormat="text" spiffworkflow:aiMaxRetries="1">
      <bpmn:incoming>f7b</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="write_document" name="Write / Finalize Document" spiffworkflow:taskActions="[{&#34;action&#34;:&#34;Submit&#34;}]">
      <bpmn:documentation>Author finalizes the document in the already-created file — either by editing the AI draft (sop_markdown) or writing it manually from scratch. Either way works the same from here on.</bpmn:documentation>
      <bpmn:incoming>Flow_0f2r7ad</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="content_approval" name="Approve Final Document" spiffworkflow:assigneeMode="DocField" spiffworkflow:targetDoctype="Document Request" spiffworkflow:assigneeDocfield="approver_user" spiffworkflow:taskActions="[{&#34;action&#34;:&#34;Approve&#34;,&#34;confirmTransition&#34;:&#34;true&#34;},{&#34;action&#34;:&#34;Reject&#34;,&#34;confirmTransition&#34;:&#34;true&#34;}]">
      <bpmn:documentation>Second, separate approval — on the finished content this time, not the original request.</bpmn:documentation>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_content" name="Content Approved?" default="f12">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="save_content" name="Save Final Content to Drive" spiffworkflow:serverScript="Drive — Update Content" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="Drive — Update Content">
      <bpmn:documentation>Pushes the finalized sop_markdown into the placeholder file create_file made earlier, now that drafting/review/approval is done.</bpmn:documentation>
      <bpmn:incoming>f11c</bpmn:incoming>
      <bpmn:outgoing>f11b</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="set_perms" name="Set Drive Sharing Permissions" spiffworkflow:serverScript="Drive — Set Permissions" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="Drive — Set Permissions">
      <bpmn:documentation>Starter grant: domain-wide reader for one-fm.com (override via task variable drive_grants, a JSON string). Should eventually be derived from Frappe Role/User Permissions on the Controlled Document record rather than this fixed default.</bpmn:documentation>
      <bpmn:incoming>f11b</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="index_doc" name="Index Document for AI Reference" spiffworkflow:serverScript="Drive — Index Document" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="Drive — Index Document">
      <bpmn:documentation>Creates/updates an AI Reference Index record (keyed on the Drive file id) with this document's title, type, link, and content. This is keyword-searchable cataloging, not semantic/vector indexing — real RAG embeddings are still a separate, larger build. Purging this record on disposal is required for compliance (see the Deletion &amp; Disposal process design).</bpmn:documentation>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="set_status_published" name="Set Status: Published" spiffworkflow:serviceType="update_field" spiffworkflow:updateFieldRows="[{&#34;field&#34;: &#34;status&#34;, &#34;value&#34;: &#34;Published&#34;}]">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f14b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_published" name="Document Published">
      <bpmn:incoming>f14b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start1" targetRef="request_approval" />
    <bpmn:sequenceFlow id="f2" sourceRef="request_approval" targetRef="gw_request" />
    <bpmn:sequenceFlow id="f3" name="Approved" sourceRef="gw_request" targetRef="notify_request_approved">
      <bpmn:conditionExpression>action == "Approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f3b" sourceRef="notify_request_approved" targetRef="set_status_drafting" />
    <bpmn:sequenceFlow id="f3c" sourceRef="set_status_drafting" targetRef="gw_action" />
    <bpmn:sequenceFlow id="f3d" sourceRef="gw_action" targetRef="create_file" />
    <bpmn:sequenceFlow id="f3e" name="Locate Existing file" sourceRef="gw_action" targetRef="locate_existing_file">
      <bpmn:conditionExpression>request_action == "Update"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f3f" name="Delete" sourceRef="gw_action" targetRef="delete_file">
      <bpmn:conditionExpression>request_action == "Delete"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f5a" sourceRef="create_file" targetRef="gw_action_merge" />
    <bpmn:sequenceFlow id="f5b" sourceRef="locate_existing_file" targetRef="gw_action_merge" />
    <bpmn:sequenceFlow id="f_del1" sourceRef="delete_file" targetRef="set_status_deleted" />
    <bpmn:sequenceFlow id="f_del2" sourceRef="set_status_deleted" targetRef="end_deleted" />
    <bpmn:sequenceFlow id="f4" sourceRef="gw_request" targetRef="notify_request_rejected" />
    <bpmn:sequenceFlow id="f5" sourceRef="gw_action_merge" targetRef="gather_context" />
    <bpmn:sequenceFlow id="f6" sourceRef="gather_context" targetRef="fetch_guideline" />
    <bpmn:sequenceFlow id="f7" sourceRef="fetch_guideline" targetRef="fetch_sop_template" />
    <bpmn:sequenceFlow id="f7b" sourceRef="fetch_sop_template" targetRef="sop_task" />
    <bpmn:sequenceFlow id="f8" sourceRef="sop_task" targetRef="Gateway_0lo7hq2" />
    <bpmn:sequenceFlow id="f9" sourceRef="write_document" targetRef="content_approval" />
    <bpmn:sequenceFlow id="f10" sourceRef="content_approval" targetRef="gw_content" />
    <bpmn:sequenceFlow id="f11" name="Approved?" sourceRef="gw_content" targetRef="notify_content_approved">
      <bpmn:conditionExpression>action == "Approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f11e" sourceRef="notify_content_approved" targetRef="set_status_approved" />
    <bpmn:sequenceFlow id="f11c" sourceRef="set_status_approved" targetRef="save_content" />
    <bpmn:sequenceFlow id="f11b" sourceRef="save_content" targetRef="set_perms" />
    <bpmn:sequenceFlow id="f12" sourceRef="gw_content" targetRef="notify_content_rejected" />
    <bpmn:sequenceFlow id="f12d" sourceRef="notify_content_rejected" targetRef="set_status_content_rejected" />
    <bpmn:sequenceFlow id="f12b" sourceRef="set_status_content_rejected" targetRef="Gateway_0lo7hq2" />
    <bpmn:sequenceFlow id="f13" sourceRef="set_perms" targetRef="index_doc" />
    <bpmn:sequenceFlow id="f14" sourceRef="index_doc" targetRef="set_status_published" />
    <bpmn:sequenceFlow id="f14b" sourceRef="set_status_published" targetRef="end_published" />
    <bpmn:exclusiveGateway id="Gateway_0lo7hq2">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f12b</bpmn:incoming>
      <bpmn:outgoing>Flow_0f2r7ad</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0f2r7ad" sourceRef="Gateway_0lo7hq2" targetRef="write_document" />
    <bpmn:sequenceFlow id="Flow_0mot6rw" sourceRef="set_status_rejected" targetRef="end_rejected" />
