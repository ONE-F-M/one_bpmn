<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="msg_chat" name="ChatConversation_Message_Action" />
  <bpmn:message id="msg_close" name="ChatConversation_Close_Action" />
  <bpmn:process id="lumina_chat_general" name="Others" isExecutable="true">
    <bpmn:startEvent id="chat_start" name="New Conversation">
      <bpmn:outgoing>flow_start_validate</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="ConditionalEventDefinition_038cx7h" spiffworkflow:triggerDoctype="Chat Conversation" spiffworkflow:triggerType="After Insert">
        <bpmn:condition>agent_mode=="{{ CHAT_MODE_LABEL }}"</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw_wait_merge">
      <bpmn:incoming>flow_update_merge</bpmn:incoming>
      <bpmn:incoming>flow_start_validate</bpmn:incoming>
      <bpmn:outgoing>flow_merge_ebg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="ebg_wait" name="Waiting for User Message">
      <bpmn:incoming>flow_merge_ebg</bpmn:incoming>
      <bpmn:outgoing>flow_ebg_msg</bpmn:outgoing>
      <bpmn:outgoing>flow_ebg_close</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="catch_msg" name="Message Received">
      <bpmn:incoming>flow_ebg_msg</bpmn:incoming>
      <bpmn:outgoing>flow_msg_save</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_chat" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catch_close" name="Conversation Closed">
      <bpmn:incoming>flow_ebg_close</bpmn:incoming>
      <bpmn:outgoing>flow_close_cleanup</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_close" />
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="save_msg" name="Save User Message" spiffworkflow:serverScript="LChat – Save User Message" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat – Save User Message">
      <bpmn:incoming>flow_msg_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_build</bpmn:outgoing>
      <bpmn:script>LChat – Save User Message</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="build_context" name="Build Context" spiffworkflow:serverScript="LChat – Build Context" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat – Build Context">
      <bpmn:incoming>flow_save_build</bpmn:incoming>
      <bpmn:outgoing>flow_build_route</bpmn:outgoing>
      <bpmn:script>LChat – Build Context</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="flow_build_route" sourceRef="build_context" targetRef="Gateway_0y1me24" />
    <bpmn:scriptTask id="save_response" name="Save AI Response" spiffworkflow:serverScript="LChat – Save Response" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat – Save Response">
      <bpmn:incoming>Flow_0i64shi</bpmn:incoming>
      <bpmn:outgoing>flow_save_update</bpmn:outgoing>
      <bpmn:script>LChat – Save Response</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="update_conv" name="Update Conversation" spiffworkflow:serverScript="LChat – Update Conversation" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat – Update Conversation">
      <bpmn:incoming>flow_save_update</bpmn:incoming>
      <bpmn:outgoing>flow_update_merge</bpmn:outgoing>
      <bpmn:script>LChat – Update Conversation</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="cleanup" name="Cleanup" spiffworkflow:serverScript="LChat – Cleanup" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat – Cleanup">
      <bpmn:incoming>flow_close_cleanup</bpmn:incoming>
      <bpmn:outgoing>flow_cleanup_end</bpmn:outgoing>
      <bpmn:script>LChat – Cleanup</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="end_close" name="Conversation Ended">
      <bpmn:incoming>flow_cleanup_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_validate" sourceRef="chat_start" targetRef="gw_wait_merge" />
    <bpmn:sequenceFlow id="flow_merge_ebg" sourceRef="gw_wait_merge" targetRef="ebg_wait" />
    <bpmn:sequenceFlow id="flow_ebg_msg" sourceRef="ebg_wait" targetRef="catch_msg" />
    <bpmn:sequenceFlow id="flow_ebg_close" sourceRef="ebg_wait" targetRef="catch_close" />
    <bpmn:sequenceFlow id="flow_msg_save" sourceRef="catch_msg" targetRef="save_msg" />
    <bpmn:sequenceFlow id="flow_save_build" sourceRef="save_msg" targetRef="build_context" />
    <bpmn:sequenceFlow id="flow_save_update" sourceRef="save_response" targetRef="update_conv" />
    <bpmn:sequenceFlow id="flow_update_merge" sourceRef="update_conv" targetRef="gw_wait_merge" />
    <bpmn:sequenceFlow id="flow_close_cleanup" sourceRef="catch_close" targetRef="cleanup" />
    <bpmn:sequenceFlow id="flow_cleanup_end" sourceRef="cleanup" targetRef="end_close" />
    <bpmn:exclusiveGateway id="Gateway_0y1me24">
      <bpmn:incoming>flow_build_route</bpmn:incoming>
      <bpmn:incoming>Flow_09s7hd9</bpmn:incoming>
      <bpmn:outgoing>Flow_1wewel9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1wewel9" sourceRef="Gateway_0y1me24" targetRef="ai_agent_task" />
    <bpmn:exclusiveGateway id="Gateway_05pc6fn" name="Needs to call tools?" default="Flow_0i64shi">
      <bpmn:incoming>Flow_03lebfw</bpmn:incoming>
      <bpmn:outgoing>Flow_0i64shi</bpmn:outgoing>
      <bpmn:outgoing>Flow_03zyjkk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0i64shi" name="Save response" sourceRef="Gateway_05pc6fn" targetRef="save_response" />
    <bpmn:sequenceFlow id="Flow_03zyjkk" name="Call tools" sourceRef="Gateway_05pc6fn" targetRef="lumina_tools">
      <bpmn:conditionExpression>(agent_decision2 or {}).get("needs_tool") == True</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09s7hd9" sourceRef="lumina_tools" targetRef="Gateway_0y1me24" />
    <bpmn:adHocSubProcess id="lumina_tools" name="Lumina Tools">
      <bpmn:incoming>Flow_03zyjkk</bpmn:incoming>
      <bpmn:outgoing>Flow_09s7hd9</bpmn:outgoing>
      <bpmn:scriptTask id="check_permission" name="Check Permission" spiffworkflow:serverScript="LChat Tool – Check Permission" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – Check Permission" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;doctype&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The DocType to check permission for.&#34;}, &#34;name&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;Optional document name.&#34;}, &#34;ptype&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;Permission type, e.g. &#39;read&#39;/&#39;write&#39;/&#39;submit&#39;. Defaults to &#39;read&#39;.&#34;}}, &#34;required&#34;: [&#34;doctype&#34;]}">
        <bpmn:documentation>Check if the current user has a specific permission on a document or DocType.</bpmn:documentation>
        <bpmn:script>LChat Tool – Check Permission</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="list_available_doctypes" name="List Available Doctypes" spiffworkflow:serverScript="LChat Tool – List Available Doctypes" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – List Available Doctypes" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;module&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;Optional module name.&#34;}, &#34;search&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;Optional search string to filter DocType names.&#34;}}, &#34;required&#34;: []}">
        <bpmn:documentation>List all available DocTypes, optionally filtered by module or search string.</bpmn:documentation>
        <bpmn:script>LChat Tool – List Available Doctypes</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="query_doctypes" name="Query Doctypes" spiffworkflow:serverScript="LChat Tool – Query Doctypes" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – Query Doctypes" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;doctype&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The DocType to query.&#34;}, &#34;filters&#34;: {&#34;type&#34;: &#34;object&#34;, &#34;description&#34;: &#34;Optional filters, e.g. {&#39;status&#39;: &#39;Open&#39;}.&#34;}, &#34;fields&#34;: {&#34;type&#34;: &#34;array&#34;, &#34;items&#34;: {&#34;type&#34;: &#34;string&#34;}, &#34;description&#34;: &#34;Fields to retrieve.&#34;}, &#34;order_by&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;e.g. &#39;creation desc&#39;.&#34;}, &#34;limit&#34;: {&#34;type&#34;: &#34;integer&#34;, &#34;description&#34;: &#34;Max results (default 20, max 50).&#34;}}, &#34;required&#34;: [&#34;doctype&#34;]}">
        <bpmn:documentation>Execute filtered queries on DocTypes with safety limits (respects the current user's permissions).</bpmn:documentation>
        <bpmn:script>LChat Tool – Query Doctypes</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="get_doctype_schema" name="Get Doctype Schema" spiffworkflow:serverScript="LChat Tool – Get DocType Schema" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – Get DocType Schema" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;doctype&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The DocType to retrieve the schema for.&#34;}}, &#34;required&#34;: [&#34;doctype&#34;]}">
        <bpmn:documentation>Get complete DocType metadata including fields, permissions, and links.</bpmn:documentation>
        <bpmn:script>LChat Tool – Get DocType Schema</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="get_workflow_state" name="Get Workflow State" spiffworkflow:serverScript="LChat Tool – Get Workflow State" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – Get Workflow State" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;doctype&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The DocType name, e.g. &#39;Task&#39;.&#34;}, &#34;name&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The document name/ID.&#34;}}, &#34;required&#34;: [&#34;doctype&#34;, &#34;name&#34;]}">
        <bpmn:documentation>Get the current workflow state and available transitions for a document.</bpmn:documentation>
        <bpmn:script>LChat Tool – Get Workflow State</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="navigate_to" name="Navigate To" spiffworkflow:serverScript="LChat Tool – Navigate To" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – Navigate To" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;doctype&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The DocType to navigate to.&#34;}, &#34;name&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;Optional document name; omit for the list view.&#34;}}, &#34;required&#34;: [&#34;doctype&#34;]}">
        <bpmn:documentation>Get a navigation URL for a document or DocType list.</bpmn:documentation>
        <bpmn:script>LChat Tool – Navigate To</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="get_linked_documents" name="Get Linked Documents" spiffworkflow:serverScript="LChat Tool – Get Linked Documents" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – Get Linked Documents" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;doctype&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The DocType of the source document.&#34;}, &#34;name&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The name/ID of the source document.&#34;}}, &#34;required&#34;: [&#34;doctype&#34;, &#34;name&#34;]}">
        <bpmn:documentation>Get documents that are linked TO the specified document.</bpmn:documentation>
        <bpmn:script>LChat Tool – Get Linked Documents</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="get_count" name="Get Count" spiffworkflow:serverScript="LChat Tool – Get Count" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – Get Count" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;doctype&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The DocType to count.&#34;}, &#34;filters&#34;: {&#34;type&#34;: &#34;object&#34;, &#34;description&#34;: &#34;Optional filter dict.&#34;}}, &#34;required&#34;: [&#34;doctype&#34;]}">
        <bpmn:documentation>Count documents matching criteria (cached 10 minutes).</bpmn:documentation>
        <bpmn:script>LChat Tool – Get Count</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="get_list" name="Get List" spiffworkflow:serverScript="LChat Tool – Get List" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – Get List" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;doctype&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The DocType to list documents from.&#34;}, &#34;filters&#34;: {&#34;type&#34;: &#34;object&#34;, &#34;description&#34;: &#34;Optional filter dict, e.g. {&#39;status&#39;: &#39;Open&#39;}.&#34;}, &#34;fields&#34;: {&#34;type&#34;: &#34;array&#34;, &#34;items&#34;: {&#34;type&#34;: &#34;string&#34;}, &#34;description&#34;: &#34;Fields to return per document.&#34;}, &#34;limit_start&#34;: {&#34;type&#34;: &#34;integer&#34;, &#34;description&#34;: &#34;Pagination offset.&#34;}, &#34;limit_page_length&#34;: {&#34;type&#34;: &#34;integer&#34;, &#34;description&#34;: &#34;Records per page.&#34;}, &#34;order_by&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;e.g. &#39;modified desc&#39;.&#34;}}, &#34;required&#34;: [&#34;doctype&#34;]}">
        <bpmn:documentation>List documents from a DocType with filtering and pagination (respects the current user's permissions).</bpmn:documentation>
        <bpmn:script>LChat Tool – Get List</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="check_module_exists" name="Check Module Exists" spiffworkflow:serverScript="LChat Tool – Check Module Exists" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – Check Module Exists" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;module_name&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The name of the Module to check.&#34;}}, &#34;required&#34;: [&#34;module_name&#34;]}">
        <bpmn:documentation>Check if a given Module exists in the system.</bpmn:documentation>
        <bpmn:script>LChat Tool – Check Module Exists</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="check_doctype_exists" name="Check Doctype Exists" spiffworkflow:serverScript="LChat Tool – Check DocType Exists" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – Check DocType Exists" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;doctype_name&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The name of the DocType to check.&#34;}}, &#34;required&#34;: [&#34;doctype_name&#34;]}">
        <bpmn:documentation>Check if a given DocType exists in the system.</bpmn:documentation>
        <bpmn:script>LChat Tool – Check DocType Exists</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="get_report_data" name="Get Report Data" spiffworkflow:serverScript="LChat Tool – Get Report Data" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – Get Report Data" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;report_name&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The name of the report to execute.&#34;}, &#34;filters&#34;: {&#34;type&#34;: &#34;object&#34;, &#34;description&#34;: &#34;Optional filters to apply to the report.&#34;}, &#34;cache&#34;: {&#34;type&#34;: &#34;boolean&#34;, &#34;description&#34;: &#34;Whether to use cached results (default true).&#34;}}, &#34;required&#34;: [&#34;report_name&#34;]}">
        <bpmn:documentation>Execute a report and return its data.</bpmn:documentation>
        <bpmn:script>LChat Tool – Get Report Data</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="list_reports" name="List Reports" spiffworkflow:serverScript="LChat Tool – List Reports" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – List Reports" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;module&#34;: {&#34;type&#34;: &#34;string&#34;}, &#34;doctype&#34;: {&#34;type&#34;: &#34;string&#34;}}, &#34;required&#34;: []}">
        <bpmn:documentation>List available reports, optionally filtered by module or DocType.</bpmn:documentation>
        <bpmn:script>LChat Tool – List Reports</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="query_documents" name="Query Documents" spiffworkflow:serverScript="LChat Tool – Query Documents" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – Query Documents" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;doctype&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;enum&#34;: [&#34;Leave Application&#34;, &#34;Attendance&#34;, &#34;Salary Slip&#34;, &#34;HD Ticket&#34;, &#34;ToDo&#34;, &#34;Task&#34;], &#34;description&#34;: &#34;The Frappe doctype to query&#34;}, &#34;limit&#34;: {&#34;type&#34;: &#34;integer&#34;, &#34;description&#34;: &#34;Max records to return (default 5)&#34;}}, &#34;required&#34;: [&#34;doctype&#34;]}">
        <bpmn:documentation>Query the current user's own Frappe/ERPNext records — leave applications, attendance, salary slips, support tickets, todos, or tasks.</bpmn:documentation>
        <bpmn:script>LChat Tool – Query Documents</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="search_wiki" name="Search Wiki" spiffworkflow:serverScript="LChat Tool – Search Wiki" spiffworkflow:scriptType="Server Script" spiffworkflow:scriptName="LChat Tool – Search Wiki" spiffworkflow:aiToolParams="{&#34;properties&#34;: {&#34;query&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;description&#34;: &#34;The search query to find relevant wiki articles&#34;}}, &#34;required&#34;: [&#34;query&#34;]}">
        <bpmn:documentation>Search the company wiki for policies, procedures, or company-specific information relevant to the user's question.</bpmn:documentation>
        <bpmn:script>LChat Tool – Search Wiki</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">True</bpmn:completionCondition>
    </bpmn:adHocSubProcess>
    <bpmn:serviceTask id="ai_agent_task" name="Lumina Agent" spiffworkflow:serviceType="ai_agent" spiffworkflow:aiBackend="direct_api" spiffworkflow:aiProvider="Claude" spiffworkflow:aiModel="claude-haiku-4-5-20251001" spiffworkflow:aiOutputVariable="agent_decision2" spiffworkflow:aiSystemPrompt="{{ SYSTEM_PROMPT }}" spiffworkflow:aiUserPrompt="Conversation so far:&#10;{{ chat_history_text }}&#10;&#10;Latest user message: {{ user_text }}&#10;&#10;Information already looked up this turn:&#10;{% if tool_history %}{% for h in tool_history %}- {{ h.tool }}: {{ h.result }}&#10;{% endfor %}{% else %}(none yet){% endif %}" spiffworkflow:aiResponseFormat="json" spiffworkflow:aiResponseSchema="{&#34;type&#34;: &#34;object&#34;, &#34;properties&#34;: {&#34;needs_tool&#34;: {&#34;type&#34;: &#34;boolean&#34;}, &#34;final_answer&#34;: {&#34;type&#34;: &#34;string&#34;}}, &#34;required&#34;: [&#34;needs_tool&#34;]}" spiffworkflow:aiTemperature="0.3" spiffworkflow:aiTopP="1" spiffworkflow:aiMaxTokens="1024" spiffworkflow:aiTimeout="30" spiffworkflow:aiMaxRetries="2" spiffworkflow:aiToolsAdhoc="lumina_tools" spiffworkflow:aiConversationStore="process_variable" spiffworkflow:aiContextMaxMessages="20">
      <bpmn:incoming>Flow_1wewel9</bpmn:incoming>
      <bpmn:outgoing>Flow_03lebfw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_03lebfw" sourceRef="ai_agent_task" targetRef="Gateway_05pc6fn" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_1">
    <bpmndi:BPMNPlane id="plane_1" bpmnElement="lumina_chat_general">
      <bpmndi:BPMNShape id="chat_start_di" bpmnElement="chat_start">
        <dc:Bounds x="162" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_wait_merge_di" bpmnElement="gw_wait_merge" isMarkerVisible="true">
        <dc:Bounds x="255" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ebg_wait_di" bpmnElement="ebg_wait">
        <dc:Bounds x="355" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="337" y="97.5" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="catch_msg_di" bpmnElement="catch_msg">
        <dc:Bounds x="462" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="catch_close_di" bpmnElement="catch_close">
        <dc:Bounds x="362" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="282.5" y="266" width="69" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="save_msg_di" bpmnElement="save_msg">
        <dc:Bounds x="550" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="build_context_di" bpmnElement="build_context">
        <dc:Bounds x="710" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="save_response_di" bpmnElement="save_response">
