<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_ThreatAssessmentSitrep"
    targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="threat_assessment_sitrep_process" name="Daily Threat SITREP" isExecutable="true">
    <bpmn:documentation>Daily noon Kuwait-window threat SITREP generation: collect Threat Feed activity in the last 24h, classify it, ask the SITREP agent for a structured assessment, and render/attach the PDF report. Replaces onefm_mcp's threat_assessment_agent LangGraph pipeline (WI-002201).</bpmn:documentation>

    <bpmn:startEvent id="timer_start" name="Daily Noon Trigger">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Noon">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 12 * * *</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:scriptTask id="compute_window_check_exists" name="Compute Window &amp; Check Existing"
        spiffworkflow:serverScript="SITREP — Compute Window and Check Existing"
        spiffworkflow:scriptType="Server Script"
        spiffworkflow:scriptName="SITREP — Compute Window and Check Existing">
      <bpmn:documentation>Kuwait-TZ 24h window (yesterday 12pm -&gt; today 12pm, converted to UTC). Sets already_generated so a same-day rerun short-circuits instead of colliding on the report's per-day autoname.</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="gw_already_generated" name="Already Generated Today?" default="f3">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f_already_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_already_generated" name="Already Generated">
      <bpmn:incoming>f_already_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:scriptTask id="create_draft_report" name="Create Draft Report"
        spiffworkflow:serverScript="SITREP — Create Draft Report"
        spiffworkflow:scriptType="Server Script"
        spiffworkflow:scriptName="SITREP — Create Draft Report">
      <bpmn:documentation>Inserts the Threat Assessment Report draft for today's window.</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="collect_and_classify" name="Collect &amp; Classify Threats"
        spiffworkflow:serverScript="SITREP — Collect and Classify Threats"
        spiffworkflow:scriptType="Server Script"
        spiffworkflow:scriptName="SITREP — Collect and Classify Threats">
      <bpmn:documentation>Queries Threat Feed/Threat Feed Keyword in the window, classifies security vs environmental by keyword match (ported verbatim from sitrep_agent_data_collector.py), updates the report's raw counts. On failure sets generation_status=Failed on the report and in task data.</bpmn:documentation>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="gw_collect_failed" name="Collection Failed?" default="f6">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f_collect_failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="gw_zero_threats" name="Zero Threats?" default="f7">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f_zero</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:scriptTask id="mark_no_activity" name="Mark No Activity"
        spiffworkflow:serverScript="SITREP — Mark No Activity"
        spiffworkflow:scriptType="Server Script"
        spiffworkflow:scriptName="SITREP — Mark No Activity">
      <bpmn:documentation>Zero Threat Feed rows in the window: skip the LLM call entirely and close out the report as Generated with an empty summary.</bpmn:documentation>
      <bpmn:incoming>f_zero</bpmn:incoming>
      <bpmn:outgoing>f_no_activity_end</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="end_no_activity" name="No Activity">
      <bpmn:incoming>f_no_activity_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="sitrep_agent_task" name="AI Agent Task: Draft SITREP"
        spiffworkflow:serviceType="ai_agent"
        spiffworkflow:aiAgentConfig="Threat SITREP Agent"
        spiffworkflow:aiStopOnError="false"
        spiffworkflow:aiOutputVariable="sitrep_agent_output"
        spiffworkflow:aiMaxToolCalls="1"
        spiffworkflow:aiToolsAdhoc="sitrep_tools"
        spiffworkflow:aiUserPrompt="Report date: {{ report_date }}. Security threats collected ({{ security_count }}): {{ threat_data.security | tojson }}. Environmental threats collected ({{ environmental_count }}): {{ threat_data.environmental | tojson }}. Analyze this data now, apply the geographic and classification rules from your instructions, and call finalize_sitrep exactly once with your complete structured assessment.">
      <bpmn:documentation>Prompt/model/temperature come from the "Threat SITREP Agent" AI Agent Configuration (agent_id=threat_sitrep_agent), which must be enabled and lifecycle_status=Live before this map can compile. aiStopOnError is false so a missed/malformed tool call degrades gracefully into a Failed report (checked by the next Script Task) instead of erroring the whole instance.</bpmn:documentation>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:adHocSubProcess id="sitrep_tools" name="SITREP Tools">
      <bpmn:documentation>Disconnected from the sequence flow by design (no incoming/outgoing) — referenced by sitrep_agent_task's aiToolsAdhoc. The single tool the agent may call.</bpmn:documentation>
      <bpmn:scriptTask id="finalize_sitrep" name="Finalize SITREP"
          spiffworkflow:serverScript="SITREP — Finalize Tool"
          spiffworkflow:scriptType="Server Script"
          spiffworkflow:scriptName="SITREP — Finalize Tool"
          spiffworkflow:aiToolParams="{&quot;type&quot;: &quot;object&quot;, &quot;properties&quot;: {&quot;executive_summary&quot;: {&quot;type&quot;: &quot;string&quot;}, &quot;security_insights&quot;: {&quot;type&quot;: &quot;array&quot;, &quot;items&quot;: {&quot;type&quot;: &quot;string&quot;}}, &quot;environmental_insights&quot;: {&quot;type&quot;: &quot;array&quot;, &quot;items&quot;: {&quot;type&quot;: &quot;string&quot;}}, &quot;geographic_analysis&quot;: {&quot;type&quot;: &quot;array&quot;, &quot;items&quot;: {&quot;type&quot;: &quot;string&quot;}}, &quot;trend_analysis&quot;: {&quot;type&quot;: &quot;array&quot;, &quot;items&quot;: {&quot;type&quot;: &quot;string&quot;}}, &quot;security_threats&quot;: {&quot;type&quot;: &quot;array&quot;, &quot;items&quot;: {&quot;type&quot;: &quot;object&quot;, &quot;properties&quot;: {&quot;name&quot;: {&quot;type&quot;: &quot;string&quot;}, &quot;threat_level&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;enum&quot;: [&quot;High&quot;, &quot;Medium&quot;, &quot;Low&quot;]}, &quot;location&quot;: {&quot;type&quot;: &quot;string&quot;}}, &quot;required&quot;: [&quot;name&quot;, &quot;threat_level&quot;]}}, &quot;environmental_threats&quot;: {&quot;type&quot;: &quot;array&quot;, &quot;items&quot;: {&quot;type&quot;: &quot;object&quot;, &quot;properties&quot;: {&quot;name&quot;: {&quot;type&quot;: &quot;string&quot;}, &quot;threat_level&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;enum&quot;: [&quot;High&quot;, &quot;Medium&quot;, &quot;Low&quot;]}, &quot;location&quot;: {&quot;type&quot;: &quot;string&quot;}}, &quot;required&quot;: [&quot;name&quot;, &quot;threat_level&quot;]}}}, &quot;required&quot;: [&quot;executive_summary&quot;, &quot;security_insights&quot;, &quot;environmental_insights&quot;, &quot;geographic_analysis&quot;, &quot;trend_analysis&quot;, &quot;security_threats&quot;, &quot;environmental_threats&quot;]}">
        <bpmn:documentation>Copies its own call arguments into result so the full structured assessment surfaces as finalize_sitrep_toolCallResult on sitrep_agent_task's data.</bpmn:documentation>
      </bpmn:scriptTask>
    </bpmn:adHocSubProcess>

    <bpmn:scriptTask id="apply_output_render_pdf" name="Apply Output &amp; Render PDF"
        spiffworkflow:serverScript="SITREP — Apply Output and Render PDF"
        spiffworkflow:scriptType="Server Script"
        spiffworkflow:scriptName="SITREP — Apply Output and Render PDF">
      <bpmn:documentation>Reads finalize_sitrep_toolCallResult; if absent (agent never called the tool), marks the report Failed. Otherwise populates the report fields/child tables, renders the PDF template, attaches it, and sets generation_status=Generated.</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="gw_apply_failed" name="Finalization Failed?" default="f10">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f_apply_failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_success" name="SITREP Complete">
      <bpmn:incoming>f10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="end_failed" name="Generation Failed">
      <bpmn:incoming>f_collect_failed</bpmn:incoming>
      <bpmn:incoming>f_apply_failed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="f1" sourceRef="timer_start" targetRef="compute_window_check_exists" />
    <bpmn:sequenceFlow id="f2" sourceRef="compute_window_check_exists" targetRef="gw_already_generated" />
    <bpmn:sequenceFlow id="f3" sourceRef="gw_already_generated" targetRef="create_draft_report" />
    <bpmn:sequenceFlow id="f_already_end" name="Yes" sourceRef="gw_already_generated" targetRef="end_already_generated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">already_generated == True</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="create_draft_report" targetRef="collect_and_classify" />
    <bpmn:sequenceFlow id="f5" sourceRef="collect_and_classify" targetRef="gw_collect_failed" />
    <bpmn:sequenceFlow id="f6" sourceRef="gw_collect_failed" targetRef="gw_zero_threats" />
    <bpmn:sequenceFlow id="f_collect_failed" name="Yes" sourceRef="gw_collect_failed" targetRef="end_failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">generation_status == "Failed"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f7" sourceRef="gw_zero_threats" targetRef="sitrep_agent_task" />
    <bpmn:sequenceFlow id="f_zero" name="Yes" sourceRef="gw_zero_threats" targetRef="mark_no_activity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">threat_count == 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_no_activity_end" sourceRef="mark_no_activity" targetRef="end_no_activity" />
    <bpmn:sequenceFlow id="f8" sourceRef="sitrep_agent_task" targetRef="apply_output_render_pdf" />
    <bpmn:sequenceFlow id="f9" sourceRef="apply_output_render_pdf" targetRef="gw_apply_failed" />
    <bpmn:sequenceFlow id="f10" sourceRef="gw_apply_failed" targetRef="end_success" />
    <bpmn:sequenceFlow id="f_apply_failed" name="Yes" sourceRef="gw_apply_failed" targetRef="end_failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">generation_status == "Failed"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="threat_assessment_sitrep_process">
      <bpmndi:BPMNShape id="Shape_timer_start" bpmnElement="timer_start">
        <dc:Bounds x="80" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_compute_window_check_exists" bpmnElement="compute_window_check_exists">
        <dc:Bounds x="170" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_gw_already_generated" bpmnElement="gw_already_generated" isMarkerVisible="true">
        <dc:Bounds x="325" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end_already_generated" bpmnElement="end_already_generated">
        <dc:Bounds x="332" y="300" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_create_draft_report" bpmnElement="create_draft_report">
        <dc:Bounds x="430" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_collect_and_classify" bpmnElement="collect_and_classify">
        <dc:Bounds x="580" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_gw_collect_failed" bpmnElement="gw_collect_failed" isMarkerVisible="true">
        <dc:Bounds x="735" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_gw_zero_threats" bpmnElement="gw_zero_threats" isMarkerVisible="true">
        <dc:Bounds x="835" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_mark_no_activity" bpmnElement="mark_no_activity">
        <dc:Bounds x="810" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end_no_activity" bpmnElement="end_no_activity">
        <dc:Bounds x="842" y="440" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_sitrep_agent_task" bpmnElement="sitrep_agent_task">
        <dc:Bounds x="935" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_sitrep_tools" bpmnElement="sitrep_tools" isExpanded="true">
        <dc:Bounds x="885" y="560" width="550" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_finalize_sitrep" bpmnElement="finalize_sitrep">
        <dc:Bounds x="920" y="640" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_apply_output_render_pdf" bpmnElement="apply_output_render_pdf">
        <dc:Bounds x="1085" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_gw_apply_failed" bpmnElement="gw_apply_failed" isMarkerVisible="true">
        <dc:Bounds x="1240" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end_success" bpmnElement="end_success">
        <dc:Bounds x="1340" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end_failed" bpmnElement="end_failed">
        <dc:Bounds x="1060" y="440" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_f1" bpmnElement="f1">
        <di:waypoint x="116" y="200" /><di:waypoint x="170" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f2" bpmnElement="f2">
        <di:waypoint x="270" y="200" /><di:waypoint x="325" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f3" bpmnElement="f3">
        <di:waypoint x="375" y="200" /><di:waypoint x="430" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f_already_end" bpmnElement="f_already_end">
        <di:waypoint x="350" y="225" /><di:waypoint x="350" y="318" /><di:waypoint x="332" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f4" bpmnElement="f4">
        <di:waypoint x="530" y="200" /><di:waypoint x="580" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f5" bpmnElement="f5">
        <di:waypoint x="680" y="200" /><di:waypoint x="735" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f6" bpmnElement="f6">
        <di:waypoint x="785" y="200" /><di:waypoint x="835" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f_collect_failed" bpmnElement="f_collect_failed">
        <di:waypoint x="760" y="225" /><di:waypoint x="760" y="380" /><di:waypoint x="1078" y="380" /><di:waypoint x="1078" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f7" bpmnElement="f7">
        <di:waypoint x="885" y="200" /><di:waypoint x="935" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f_zero" bpmnElement="f_zero">
        <di:waypoint x="860" y="225" /><di:waypoint x="860" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f_no_activity_end" bpmnElement="f_no_activity_end">
        <di:waypoint x="860" y="380" /><di:waypoint x="860" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f8" bpmnElement="f8">
        <di:waypoint x="1035" y="200" /><di:waypoint x="1085" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f9" bpmnElement="f9">
        <di:waypoint x="1185" y="200" /><di:waypoint x="1240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f10" bpmnElement="f10">
        <di:waypoint x="1290" y="200" /><di:waypoint x="1340" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f_apply_failed" bpmnElement="f_apply_failed">
        <di:waypoint x="1265" y="225" /><di:waypoint x="1265" y="380" /><di:waypoint x="1078" y="380" /><di:waypoint x="1078" y="440" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
