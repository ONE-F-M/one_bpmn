    <bpmn:exclusiveGateway id="Gateway_107uysm" name="Orchestrator?">
      <bpmn:documentation>A Work Item flagged for the orchestrator is never handed to a person: WorkItem.before_save() clears its assignee, so it would fail the Assignee Set? check downstream and loop on the assignment task forever. The split therefore happens here, before assignment, and the human path past it is unchanged.</bpmn:documentation>
      <bpmn:incoming>Flow_06d4q5r</bpmn:incoming>
      <bpmn:incoming>Flow_1tlnvwh</bpmn:incoming>
      <bpmn:outgoing>Flow_orchestrator_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_1mmdtcb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
